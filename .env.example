# Postgres (общий контейнер, БД-на-сервис)
POSTGRES_USER=doctj
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=doctj
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Аутентификация межсервисная / пользовательская
JWT_SECRET=change-me-dev-only

# LLM-провайдер (ADR 0002). mock — детерминированный ответ без сети,
# диалог симуляции работает офлайн. openai — любой OpenAI-совместимый
# эндпоинт (OpenAI, YandexGPT/GigaChat в режиме совместимости).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
